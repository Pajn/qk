{
  "name": "web",
  "projectType": "application",
  "tags": [
    "scope:web"
  ],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "configurations": {
        "production": {},
        "development": {}
      }
    },
    "test": {},
    "lint": {},
    "serve": {},
    "check": {},
    "typecheck-app": {
      "inputs": ["production", { "env": "TYPECHECK_MODE" }, { "runtime": "node --version" }],
      "command": "node scripts/task.mjs web:typecheck-app {projectRoot}"
    },
    "typecheck-strict": {
      "command": "node scripts/task.mjs web:typecheck-strict {projectRoot}"
    },
    "format": {
      "command": "node scripts/task.mjs web:format {projectRoot}"
    },
    "migrate": {
      "command": "node scripts/task.mjs web:migrate {projectRoot}",
      "parallelism": false
    },
    "verify": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck-*",
        "^lin*"
      ]
    }
  }
}
