          "web:build:production",
          "web:lint",
          "web:test"
        ],
        "qkOnly": [],
        "reason": "Nx hashes nx.json into every task, so any change to it selects every task; qk selects the tasks whose key the change moves, here the format and typecheck tasks whose definitions lose their targetDefaults"
